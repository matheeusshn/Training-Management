        <name>ScheduleValidation</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var ScheduleValidation = Class.create();
ScheduleValidation.prototype = Object.extendsObject(AbstractAjaxProcessor, {

    checkMaxVacancies: function() {
        var scheduleId = this.getParameter('sysparm_schedule_id');

        if (!scheduleId)
            return 'missing_id';

        var gr = new GlideRecord('x_1793782_traini_0_schedule');
        if (gr.get(scheduleId)) {
            var maxVac = gr.getValue('max_vacancies');
            if (!maxVac || parseInt(maxVac, 10) <= 0)
                return 'invalid';
            else
                return 'valid';
        }

        return 'not_found';
    },

    type: 'ScheduleValidation'
});]]></script>
