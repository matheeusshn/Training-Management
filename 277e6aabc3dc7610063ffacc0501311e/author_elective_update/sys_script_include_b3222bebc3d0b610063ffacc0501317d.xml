        <script><![CDATA[var ScheduleChecker = Class.create();
ScheduleChecker.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {
    checkDuplicateDate: function() {
        var date = this.getParameter('sysparm_date');
        var course = this.getParameter('sysparm_course');
       
        var gr = new GlideRecord("x_1793782_traini_0_schedule");
        gr.addQuery('training_date', date);
        gr.addQuery('course', course);
        gr.query();
 
        if (gr.next()) {
            return 'true';
        }
 
        return 'false';
    }
});]]></script>
