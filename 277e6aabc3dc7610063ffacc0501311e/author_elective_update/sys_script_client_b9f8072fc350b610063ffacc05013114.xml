        <messages/>
        <name>Duplicate Schedule</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || newValue === '') {
        return;
    }
    var trainingDate = g_form.getValue('training_date');
    var courseName = g_form.getValue('course');

    var ga = new GlideAjax('ScheduleChecker');
    ga.addParam('sysparm_name', 'checkDuplicateDate');
    ga.addParam('sysparm_date', trainingDate);
    ga.addParam('sysparm_course', courseName);
    ga.getXMLAnswer(function(response) {
        if (response === 'true') {
            g_form.addErrorMessage('This course is already scheduled on this date.');
            g_form.setValue('training_date', '');
        } else {
            g_form.clearMessages();
        }
    });

}]]></script>
