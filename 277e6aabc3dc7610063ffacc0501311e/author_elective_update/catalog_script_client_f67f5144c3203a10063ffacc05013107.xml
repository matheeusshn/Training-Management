        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || newValue === '') return;

    var ga = new GlideAjax('ScheduleUtils');
    ga.addParam('sysparm_name', 'getAvailableSchedules');
    ga.addParam('sysparm_schedule', newValue);

    ga.getXMLAnswer(function(response) {
        var msg = '';
        switch (response) {
            case 'instructor':
                msg = 'You are the instructor of this schedule and cannot enroll.';
                break;
            case 'duplicate':
                msg = 'You already have an active enrollment for this schedule.';
                break;
            case 'course_limit':
                msg = 'You have reached the limit of 3 enrollments for this course.';
                break;
            case 'no_seats':
                msg = 'This schedule is full.';
                break;
            case 'deadline':
                msg = 'The enrollment deadline has passed (only until one day before the training).';
                break;
            case 'false':
                msg = 'Error while validating this schedule. Please try again.';
                break;
        }

        if (msg !== '') {
            g_form.showFieldMsg('schedule', msg, 'error');
            g_form.setValue('schedule', '');
        } else {
            g_form.hideFieldMsg('schedule', true);
        }
    });
}]]></script>
